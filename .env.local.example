# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# SMTP settings — use your email provider's SMTP details
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-gmail@gmail.com
#   SMTP_PASS=your-app-password   ← Gmail: use App Password, not your login password

# Outlook/Hotmail example:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=corpift@outlook.com
#   SMTP_PASS=your-outlook-password

SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=corpift@outlook.com
SMTP_PASS=your-password-here

# Where to deliver the emails (defaults to corpift@outlook.com if not set)
CONTACT_EMAIL=corpift@outlook.com
